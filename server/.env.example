# ===============================================
# CHARIS Backend Environment Configuration (Template)
# Copy this file to server/.env and fill in your values
# ===============================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/charis?retryWrites=true&w=majority

# Authentication Secret & Expiry Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend Client URL (for CORS and redirects)
CLIENT_URL=http://localhost:5173

# Optional: Legacy Client Origin alias
CLIENT_ORIGIN=http://localhost:5173

# Optional: AI Provider API Key (server-side only, do not expose to client)
LLM_API_KEY=your_gemini_or_openai_api_key_here
